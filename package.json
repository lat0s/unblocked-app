{
  "name": "unblocked",
  "version": "0.1.0",
  "description": "Brain dump in, plan out. A local-first desktop planner that turns messy notes into tasks and events, and asks before it guesses.",
  "license": "MIT",
  "author": "George Latos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "package": "tauri build",
    "web": "vp dev",
    "test": "vp test --run && cd src-tauri && cargo test",
    "check": "tsc -b && vp lint && vp fmt --check src && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "format": "vp fmt src && cd src-tauri && cargo fmt",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/archivo-black": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@sentry/browser": "^11.10.0",
    "@tanstack/react-query": "^5.105.0",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
